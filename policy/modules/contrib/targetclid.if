## <summary>policy for targetclid</summary>

########################################
## <summary>
##	Execute targetclid_exec_t in the targetclid domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`targetclid_domtrans',`
	gen_require(`
		type targetclid_t, targetclid_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, targetclid_exec_t, targetclid_t)
')

######################################
## <summary>
##	Execute targetclid in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`targetclid_exec',`
	gen_require(`
		type targetclid_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, targetclid_exec_t)
')
########################################
## <summary>
##	Read targetclid PID files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`targetclid_read_pid_files',`
	gen_require(`
		type targetclid_var_run_t;
	')

	files_search_pids($1)
	read_files_pattern($1, targetclid_var_run_t, targetclid_var_run_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	an targetclid environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`targetclid_admin',`
	gen_require(`
		type targetclid_t;
		type targetclid_var_run_t;
	')

	allow $1 targetclid_t:process { signal_perms };
	ps_process_pattern($1, targetclid_t)

    tunable_policy(`deny_ptrace',`',`
        allow $1 targetclid_t:process ptrace;
    ')

	files_search_pids($1)
	admin_pattern($1, targetclid_var_run_t)
	optional_policy(`
		systemd_passwd_agent_exec($1)
		systemd_read_fifo_file_passwd_run($1)
	')
')
